@@ -0,0 +1,92 @@
+package workshop.vfx.math.sample;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static workshop.vfx.math.sample.SampleTestSupport.LIMITS;
+import static workshop.vfx.math.sample.SampleTestSupport.TIGHT;
+import static workshop.vfx.math.sample.SampleTestSupport.assertExact;
+
+import java.util.List;
+import java.util.SplittableRandom;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import workshop.vfx.math.core.Pose;
+import workshop.vfx.math.core.Quat;
+import workshop.vfx.math.core.Vec3;
+import workshop.vfx.math.curve.CubicBezier;
+import workshop.vfx.math.curve.Curve;
+import workshop.vfx.math.curve.Spiral;
+
+/** Contract section 7: immutable results, placement with M1 Pose, limits and tolerance records. */
+class SampleSetTest {
+
+    @Test
+    @DisplayName("Immutability: parameters() returns a copy; points() is unmodifiable; later changes to returned data do not affect the set")
+    void immutability() {
+        SampleSet s = Sampler.uniformParameter(Spiral.circle(2), 8, Endpoints.EXCLUDE_END, LIMITS);
+        double[] p = s.parameters();
+        p[3] = 99;
+        assertEquals(3 / 8.0, s.parameter(3));
+        assertTrue(s.parameters() != s.parameters(), "a new copy each call");
+        List<Vec3> pts = s.points();
+        assertThrows(UnsupportedOperationException.class, () -> pts.set(0, Vec3.ZERO));
+        assertThrows(UnsupportedOperationException.class, () -> pts.add(Vec3.ZERO));
+        assertEquals(8, pts.size());
+        assertExact(s.point(5), pts.get(5), "points() matches point(i)");
+        assertThrows(IndexOutOfBoundsException.class, () -> s.point(8));
+        assertThrows(IndexOutOfBoundsException.class, () -> s.parameter(-1));
+    }
+
+    @Test
+    @DisplayName("transformed(pose): the same parameters, and points bit for bit equal to curve.transformed(pose).point(t) (sample once, move every tick)")
+    void transformedMatchesPosedCurve() {
+        SplittableRandom r = new SplittableRandom(431);
+        for (int i = 0; i < 500; i++) {
+            Curve c = r.nextBoolean() ? Spiral.conicalSpiral(r.nextDouble(0.1, 2), r.nextDouble(0.1, 4), r.nextDouble(-5, 5), r.nextDouble(-6, 6))
+                : new CubicBezier(rv(r), rv(r), rv(r), rv(r));
+            Pose pose = new Pose(new Vec3(r.nextDouble(-3e7, 3e7), r.nextDouble(-64, 320), r.nextDouble(-3e7, 3e7)),
+                new Quat(r.nextDouble(-1, 1), r.nextDouble(-1, 1), r.nextDouble(-1, 1), r.nextDouble(-1, 1)), r.nextDouble(0.1, 10));
+            ArcLengthTable t = ArcLengthTable.build(c, TIGHT, LIMITS);
+            SampleSet local = Sampler.uniformDistance(t, r.nextInt(0, 64), Endpoints.INCLUDE_END, LIMITS);
+            SampleSet world = local.transformed(pose);
+            Curve posed = c.transformed(pose);
+            assertEquals(local.size(), world.size());
+            for (int k = 0; k < local.size(); k++) {
+                assertEquals(local.parameter(k), world.parameter(k));
+                assertExact(posed.point(local.parameter(k)), world.point(k), "posed point " + k);
+                assertExact(local.point(k), Sampler.uniformDistance(t, local.size(), Endpoints.INCLUDE_END, LIMITS).point(k), "local set unchanged");
+            }
+            // relative spacing is invariant: distances scale by pose.scale()
+            for (int k = 1; k < local.size(); k++) {
+                double dl = local.point(k).distance(local.point(k - 1)), dw = world.point(k).distance(world.point(k - 1));
+                assertEquals(pose.scale() * dl, dw, 1e-12 * (1 + dw) + 1e-14 * 3e7);
+            }
+        }
+        assertThrows(IllegalArgumentException.class, () -> Sampler.uniformParameter(Spiral.circle(1), 3, Endpoints.INCLUDE_END, LIMITS).transformed(null));
+    }
+
+    private static Vec3 rv(SplittableRandom r) {
+        return new Vec3(r.nextDouble(-5, 5), r.nextDouble(-5, 5), r.nextDouble(-5, 5));
+    }
+
+    @Test
+    @DisplayName("SampleLimits: maxSamples in [1, 2^20], maxEvaluations in [256, 2^24]; ArcLengthTolerance: absolute finite >= 0, relative in [2^-40, 2^-3]")
+    void limitsAndTolerances() {
+        assertEquals(1 << 20, SampleLimits.MAX_SAMPLES_CEILING);
+        assertEquals(256, SampleLimits.MIN_EVALUATIONS);
+        assertEquals(1 << 24, SampleLimits.MAX_EVALUATIONS_CEILING);
+        new SampleLimits(1, 256);
+        new SampleLimits(1 << 20, 1 << 24);
+        for (int[] bad : new int[][] {{0, 256}, {-1, 256}, {(1 << 20) + 1, 256}, {1, 255}, {1, (1 << 24) + 1}, {1, -5}}) {
+            assertThrows(IllegalArgumentException.class, () -> new SampleLimits(bad[0], bad[1]));
+        }
+        assertEquals(0x1p-40, ArcLengthTolerance.MIN_RELATIVE);
+        assertEquals(0x1p-3, ArcLengthTolerance.MAX_RELATIVE);
+        new ArcLengthTolerance(0, 0x1p-40);
+        new ArcLengthTolerance(1e300, 0x1p-3);
+        for (double[] bad : new double[][] {{-1e-300, 1e-6}, {Double.NaN, 1e-6}, {Double.POSITIVE_INFINITY, 1e-6}, {0, 0}, {0, 0x1p-41}, {0, 0.2}, {0, Double.NaN}}) {
+            assertThrows(IllegalArgumentException.class, () -> new ArcLengthTolerance(bad[0], bad[1]));
+        }
+    }
+}
diff --git a/src/test/java/workshop/vfx/math/sample/SampleTestSupport.java b/src/test/java/workshop/vfx/math/sample/SampleTestSupport.java
new file mode 100644
index 0000000..9aa46eb
--- /dev/null
+++ b/src/test/java/workshop/vfx/math/sample/SampleTestSupport.java
@@ -0,0 +1,222 @@
+package workshop.vfx.math.sample;
+
+import static org.junit.jupiter.api.Assertions.fail;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.List;
+import workshop.vfx.math.core.Vec3;
+import workshop.vfx.math.curve.CubicBezier;
+import workshop.vfx.math.curve.Curve;
+import workshop.vfx.math.curve.LineSegment;
+import workshop.vfx.math.curve.QuadraticBezier;
+import workshop.vfx.math.curve.Spiral;
+
+/**
+ * Helpers for the M4 tests. Nothing here integrates a speed or inverts an arc length the way the contract recommends:
+ * the oracles are the generator's exact or 1e-28 values (tools/generate_m4_reference_vectors.py), closed forms
+ * (lines, constant-speed spirals, and the asinh antiderivative of sqrt(a t^2 + b t + c) for quadratic Beziers and
+ * spirals, evaluated in double here), and the M3 contract's derivative error bounds restated from the inputs.
+ */
+final class SampleTestSupport {
+    private SampleTestSupport() {}
+
+    static final double EPS = 0x1p-53;
+    static final double ETA = Double.MIN_VALUE;
+    static final SampleLimits LIMITS = new SampleLimits(1 << 16, 1 << 20);
+    static final ArcLengthTolerance TIGHT = new ArcLengthTolerance(0, 0x1p-30);
+
+    static double hex(String s) {
+        return Double.parseDouble(s);
+    }
+
+    static void assertExact(Vec3 expected, Vec3 actual, String label) {
+        if (!(expected.x() == actual.x() && expected.y() == actual.y() && expected.z() == actual.z())) {
+            fail(label + ": expected exactly " + expected + " but was " + actual);
+        }
+    }
+
+    static double maxAbs(Vec3 v) {
+        return Math.max(Math.abs(v.x()), Math.max(Math.abs(v.y()), Math.abs(v.z())));
+    }
+
+    // ------------------------------------------------------------ reference data
+
+    static List<String[]> csv(String name) {
+        String path = "/m4/reference/" + name;
+        try (InputStream in = SampleTestSupport.class.getResourceAsStream(path)) {
+            if (in == null) {
+                fail("missing resource " + path);
+            }
+            List<String[]> rows = new ArrayList<>();
+            boolean header = false;
+            for (String line : new String(in.readAllBytes(), StandardCharsets.UTF_8).split("\n")) {
+                String t = line.trim();
+                if (t.isEmpty() || t.startsWith("#")) {
+                    continue;
+                }
+                if (!header) {
+                    header = true;
+                    continue;
+                }
+                rows.add(t.split(","));
+            }
+            return rows;
+        } catch (IOException e) {
+            fail("cannot read " + path + ": " + e);
+            return List.of();
+        }
+    }
+
+    static byte[] bytes(String path) {
+        try (InputStream in = SampleTestSupport.class.getResourceAsStream(path)) {
+            if (in == null) {
+                fail("missing resource " + path);
+            }
+            return in.readAllBytes();
+        } catch (IOException e) {
+            fail("cannot read " + path + ": " + e);
+            return new byte[0];
+        }
+    }
+
+    static Vec3 vec(double[] p, int i) {
+        return new Vec3(p[i], p[i + 1], p[i + 2]);
+    }
+
+    /** The curve of a reference row (kind, then 12 parameter columns). */
+    static Curve curveOf(String kind, double[] p) {
+        return switch (kind) {
+            case "LINE" -> new LineSegment(vec(p, 0), vec(p, 3));
+            case "QUAD" -> new QuadraticBezier(vec(p, 0), vec(p, 3), vec(p, 6));
+            case "CUBIC" -> new CubicBezier(vec(p, 0), vec(p, 3), vec(p, 6), vec(p, 9));
+            default -> new Spiral(p[0], p[1], p[2], p[3], p[4]);
+        };
+    }
+
+    static double[] params(String[] row) {
+        double[] p = new double[12];
+        for (int i = 0; i < 12; i++) {
+            p[i] = hex(row[1 + i]);
+        }
+        return p;
+    }
+
+    /**
+     * Upper bound of the absolute error of the computed speed |C'(t)| over [t0, t1], restated from the M3 contract
+     * (section 7.2 with amendment A3) from the inputs only, doubled, plus the norm's own rounding (8 eps of the
+     * speed). Integrated over the range this bounds the rounding part of the length error.
+     */
+    static double speedErrorBound(String kind, double[] p, double t0, double t1) {
+        double tm = Math.max(Math.abs(t0), Math.abs(t1));
+        double g = Math.max(Math.abs(1 - t0) + Math.abs(t0), Math.abs(1 - t1) + Math.abs(t1));
+        double comp;
+        if (kind.equals("SPIRAL")) {
+            double r0 = p[0], r1 = p[1], rise = p[2], turns = p[3];
+            double s = r0 == r1 ? r0 : g * Math.max(r0, r1);
+            double w = 2 * Math.PI * Math.abs(turns), dr = Math.abs(r1 - r0);
+            double big = dr + w * s + Math.abs(rise);
+            double dphi = 2 * Math.PI * 0x1p-52 * (Math.abs(turns) * tm + 2);
+            comp = 0x1p-48 * big + big * dphi + 4 * (1 + w + s) * ETA;
+            return 2 * (Math.sqrt(3) * comp + 8 * EPS * big);
+        }
+        int n = kind.equals("LINE") ? 1 : kind.equals("QUAD") ? 2 : 3;
+        double maxDiff = 0;
+        for (int i = 0; i < n; i++) {
+            for (int c = 0; c < 3; c++) {
+                maxDiff = Math.max(maxDiff, Math.abs(p[3 * (i + 1) + c] - p[3 * i + c]));
+            }
+        }
+        comp = 0x1p-48 * n * Math.pow(g, n - 1) * maxDiff + 2 * n * n * Math.pow(g, n) * ETA;
+        return 2 * (Math.sqrt(3) * comp + 8 * EPS * n * Math.pow(g, n - 1) * maxDiff * Math.sqrt(3));
+    }
+
+    // ------------------------------------------------------------ closed-form arc length (independent of the table)
+
+    /** Integral of sqrt(a t^2 + b t + c) over [u, v] for a quadratic that is >= 0 on R; asinh form. */
+    static double sqrtQuadraticIntegral(double a, double b, double c, double u, double v) {
+        return prim(a, b, c, v) - prim(a, b, c, u);
+    }
+
+    private static double prim(double a, double b, double c, double t) {
+        double q = Math.max(0, (a * t + b) * t + c);
+        if (a == 0) {
+            return Math.sqrt(c) * t;
+        }
+        double disc = 4 * a * c - b * b;
+        if (disc > 1e-12 * (b * b + 4 * a * Math.abs(c))) {
+            double x = (2 * a * t + b) / Math.sqrt(disc);
+            double asinh = x >= 0 ? Math.log(x + Math.sqrt(x * x + 1)) : -Math.log(-x + Math.sqrt(x * x + 1));
+            return (2 * a * t + b) * Math.sqrt(q) / (4 * a) + disc / (8 * a * Math.sqrt(a)) * asinh;
+        }
+        double ts = -b / (2 * a);
+        return Math.sqrt(a) * (t - ts) * Math.abs(t - ts) / 2;
+    }
+
+    /** Arc length of a spiral (M3 contract formula) from u to v, closed form. */
+    static double spiralLength(Spiral s, double u, double v) {
+        double dr = s.endRadius() - s.startRadius(), w = 2 * Math.PI * s.turns();
+        double a = w * w * dr * dr, b = 2 * w * w * dr * s.startRadius();
+        double c = dr * dr + s.rise() * s.rise() + w * w * s.startRadius() * s.startRadius();
+        return sqrtQuadraticIntegral(a, b, c, u, v);
+    }
+
+    /** Arc length of a quadratic Bezier from u to v, closed form. */
+    static double quadLength(QuadraticBezier q, double u, double v) {
+        Vec3 d0 = q.p1().sub(q.p0()), e = q.p2().sub(q.p1()).sub(d0);
+        double a = 4 * e.dot(e), b = 8 * d0.dot(e), c = 4 * d0.dot(d0);
+        return sqrtQuadraticIntegral(a, b, c, u, v);
+    }
+
+    // ------------------------------------------------------------ instrumented curves
+
+    /** Counts calls; delegates to an M3 curve. Not thread-safe (tests only). */
+    static final class CountingCurve implements Curve {
+        final Curve inner;
+        int points, derivatives, seconds;
+
+        CountingCurve(Curve inner) {
+            this.inner = inner;
+        }
+
+        @Override
+        public Vec3 point(double t) {
+            points++;
+            return inner.point(t);
+        }
+
+        @Override
+        public Vec3 derivative(double t) {
+            derivatives++;
+            return inner.derivative(t);
+        }
+
+        @Override
+        public Vec3 secondDerivative(double t) {
+            seconds++;
+            return inner.secondDerivative(t);
+        }
+    }
+
+    /** A user curve x = t, y = amplitude sin(2 pi frequency t): fast oscillation, adversarial for quadrature. */
+    static Curve wiggle(double amplitude, double frequency) {
+        return new Curve() {
+            @Override
+            public Vec3 point(double t) {
+                return new Vec3(t, amplitude * StrictMath.sin(2 * Math.PI * frequency * t), 0);
+            }
+
+            @Override
+            public Vec3 derivative(double t) {
+                return new Vec3(1, amplitude * 2 * Math.PI * frequency * StrictMath.cos(2 * Math.PI * frequency * t), 0);
+            }
+
+            @Override
+            public Vec3 secondDerivative(double t) {
+                return new Vec3(0, -amplitude * Math.pow(2 * Math.PI * frequency, 2) * StrictMath.sin(2 * Math.PI * frequency * t), 0);
+            }
+        };
+    }
+}
diff --git a/src/test/java/workshop/vfx/math/sample/UniformParameterTest.java b/src/test/java/workshop/vfx/math/sample/UniformParameterTest.java
new file mode 100644
index 0000000..f5acca5
--- /dev/null
+++ b/src/test/java/workshop/vfx/math/sample/UniformParameterTest.java
@@ -0,0 +1,143 @@
+package workshop.vfx.math.sample;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+import static workshop.vfx.math.sample.SampleTestSupport.LIMITS;
+import static workshop.vfx.math.sample.SampleTestSupport.assertExact;
+
+import java.math.BigDecimal;
+import java.math.MathContext;
+import java.util.SplittableRandom;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import workshop.vfx.math.core.Vec3;
+import workshop.vfx.math.curve.CubicBezier;
+import workshop.vfx.math.curve.Curve;
+import workshop.vfx.math.curve.LineSegment;
+import workshop.vfx.math.curve.Spiral;
+
+/** Contract section 4: uniform parameter sampling (normative parameters, endpoint policies, counts). */
+class UniformParameterTest {
+
+    private static final Curve CUBIC = new CubicBezier(new Vec3(0, 0, 0), new Vec3(1, 2, 0), new Vec3(3, -1, 1), new Vec3(4, 0, 0));
+
+    @Test
+    @DisplayName("On [0, 1] the parameters are exactly the correctly rounded k/(n-1) (INCLUDE_END) and k/n (EXCLUDE_END)")
+    void unitRangeIsCorrectlyRounded() {
+        for (int n : new int[] {2, 3, 5, 7, 10, 64, 100, 1000, 4097}) {
+            SampleSet open = Sampler.uniformParameter(CUBIC, n, Endpoints.INCLUDE_END, LIMITS);
+            SampleSet loop = Sampler.uniformParameter(CUBIC, n, Endpoints.EXCLUDE_END, LIMITS);
+            assertEquals(n, open.size());
+            assertEquals(n, loop.size());
+            for (int k = 0; k < n; k++) {
+                // BigDecimal division rounded to the nearest double: an independent statement of fl(k / den)
+                double incl = new BigDecimal(k).divide(new BigDecimal(n - 1), MathContext.DECIMAL128).doubleValue();
+                double excl = new BigDecimal(k).divide(new BigDecimal(n), MathContext.DECIMAL128).doubleValue();
+                assertEquals(incl, open.parameter(k), "INCLUDE_END n=" + n + " k=" + k);
+                assertEquals(excl, loop.parameter(k), "EXCLUDE_END n=" + n + " k=" + k);
+            }
+            assertEquals(1.0, open.parameter(n - 1));
+            assertTrue(loop.parameter(n - 1) < 1.0, "a closed loop never repeats the seam point");
+        }
+    }
+
+    @Test
+    @DisplayName("Counts 0, 1 and 2: empty set; one sample at the start (representative value t0) for both policies; both ends")
+    void smallCounts() {
+        for (Endpoints e : Endpoints.values()) {
+            assertEquals(0, Sampler.uniformParameter(CUBIC, 0, e, LIMITS).size());
+            SampleSet one = Sampler.uniformParameter(CUBIC, -2, 3, 1, e, LIMITS);
+            assertEquals(1, one.size());
+            assertEquals(-2.0, one.parameter(0));
+            assertExact(CUBIC.point(-2), one.point(0), "count 1 is the start point");
+        }
+        SampleSet two = Sampler.uniformParameter(CUBIC, -2, 3, 2, Endpoints.INCLUDE_END, LIMITS);
+        assertEquals(-2.0, two.parameter(0));
+        assertEquals(3.0, two.parameter(1));
+        SampleSet half = Sampler.uniformParameter(CUBIC, -2, 3, 2, Endpoints.EXCLUDE_END, LIMITS);
+        assertEquals(0.5, half.parameter(1));
+    }
+
+    @Test
+    @DisplayName("Exact endpoints and points: first parameter t0, last t1 (INCLUDE_END), every point equals curve.point(t) bit for bit; parameters non-decreasing; extrapolated and signed-zero ranges")
+    void endpointsAndPoints() {
+        SplittableRandom r = new SplittableRandom(401);
+        for (int i = 0; i < 3_000; i++) {
+            double t0 = switch (r.nextInt(4)) {
+                case 0 -> 0.0;
+                case 1 -> -0.0;
+                case 2 -> r.nextDouble(-1000, 1000);
+                default -> r.nextDouble(-1, 1) * Math.scalb(1.0, r.nextInt(-1074, 60));
+            };
+            double t1 = t0 + switch (r.nextInt(3)) {
+                case 0 -> 0;
+                case 1 -> r.nextDouble(0, 2000);
+                default -> Math.ulp(t0) * r.nextInt(1, 10);
+            };
+            int n = r.nextInt(0, 300);
+            Endpoints e = r.nextBoolean() ? Endpoints.INCLUDE_END : Endpoints.EXCLUDE_END;
+            Curve c = r.nextBoolean() ? CUBIC : new Spiral(2, 3, 1, 4, 0.1);
+            if (Math.abs(t0) > 1e6) {
+                c = new LineSegment(Vec3.ZERO, Vec3.X);
+            }
+            SampleSet s = Sampler.uniformParameter(c, t0, t1, n, e, LIMITS);
+            assertEquals(n, s.size());
+            for (int k = 0; k < n; k++) {
+                double t = s.parameter(k);
+                assertTrue(t >= t0 && t <= t1, "inside the range");
+                if (k > 0) {
+                    assertTrue(t >= s.parameter(k - 1), "non-decreasing");
+                }
+                assertExact(c.point(t), s.point(k), "point(t) bit for bit");
+            }
+            if (n > 0) {
+                assertTrue(Double.compare(t0, s.parameter(0)) == 0, "first parameter is t0 itself (sign of zero kept)");
+                if (e == Endpoints.INCLUDE_END && n > 1) {
+                    assertEquals(t1, s.parameter(n - 1), "last parameter is t1");
+                }
+            }
+        }
+    }
+
+    @Test
+    @DisplayName("Uniform parameter samples of constant-speed curves are equally spaced in distance (circle chords equal to rounding)")
+    void constantSpeedEquality() {
+        Spiral circle = Spiral.circle(7);
+        SampleSet s = Sampler.uniformParameter(circle, 24, Endpoints.EXCLUDE_END, LIMITS);
+        double chord = 2 * 7 * Math.sin(Math.PI / 24);
+        for (int k = 0; k < 24; k++) {
+            double d = s.point(k).distance(s.point((k + 1) % 24));
+            assertEquals(chord, d, 1e-13, "chord " + k);
+        }
+    }
+
+    @Test
+    @DisplayName("Validation: null curve, policy or limits; non-finite or reversed range; range width overflow; negative count; count above maxSamples (before any evaluation)")
+    void validation() {
+        SampleTestSupport.CountingCurve c = new SampleTestSupport.CountingCurve(CUBIC);
+        assertThrows(IllegalArgumentException.class, () -> Sampler.uniformParameter(null, 3, Endpoints.INCLUDE_END, LIMITS));
+        assertThrows(IllegalArgumentException.class, () -> Sampler.uniformParameter(c, 3, null, LIMITS));
+        assertThrows(IllegalArgumentException.class, () -> Sampler.uniformParameter(c, 3, Endpoints.INCLUDE_END, null));
+        assertThrows(IllegalArgumentException.class, () -> Sampler.uniformParameter(c, -1, Endpoints.INCLUDE_END, LIMITS));
+        assertThrows(IllegalArgumentException.class, () -> Sampler.uniformParameter(c, 1, 0, 3, Endpoints.INCLUDE_END, LIMITS));
+        assertThrows(IllegalArgumentException.class, () -> Sampler.uniformParameter(c, Double.NaN, 1, 3, Endpoints.INCLUDE_END, LIMITS));
+        assertThrows(IllegalArgumentException.class, () -> Sampler.uniformParameter(c, 0, Double.POSITIVE_INFINITY, 3, Endpoints.INCLUDE_END, LIMITS));
+        assertThrows(IllegalArgumentException.class, () -> Sampler.uniformParameter(c, -Double.MAX_VALUE, Double.MAX_VALUE, 3, Endpoints.INCLUDE_END, LIMITS));
+        SampleLimits small = new SampleLimits(100, 256);
+        assertEquals(100, Sampler.uniformParameter(c, 100, Endpoints.INCLUDE_END, small).size());
+        c.points = 0;
+        assertThrows(IllegalArgumentException.class, () -> Sampler.uniformParameter(c, 101, Endpoints.INCLUDE_END, small));
+        assertThrows(IllegalArgumentException.class, () -> Sampler.uniformParameter(c, Integer.MAX_VALUE, Endpoints.EXCLUDE_END, small));
+        assertEquals(0, c.points + c.derivatives + c.seconds, "rejected before evaluating the curve");
+    }
+
+    @Test
+    @DisplayName("Uniform parameter sampling evaluates point(t) exactly once per sample and never the derivatives")
+    void evaluationCount() {
+        SampleTestSupport.CountingCurve c = new SampleTestSupport.CountingCurve(CUBIC);
+        Sampler.uniformParameter(c, 257, Endpoints.EXCLUDE_END, LIMITS);
+        assertEquals(257, c.points);
+        assertEquals(0, c.derivatives + c.seconds);
+    }
+}
