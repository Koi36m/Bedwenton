+def write(path, header, rows, comment):
+    with open(path, "w", newline="\n") as f:
+        f.write("# " + comment + "\n")
+        f.write(",".join(header) + "\n")
+        for r in rows:
+            f.write(",".join(str(x) for x in r) + "\n")
