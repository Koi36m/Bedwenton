+package workshop.vfx.paper.core;
+import org.junit.jupiter.api.Test;
+import static org.junit.jupiter.api.Assertions.*;
+import java.util.*;
+import workshop.vfx.delivery.*;
+import workshop.vfx.scene.*;
+
+class ProductionEmissionTest {
+    @Test void recipientPrefixesMatchIndependentSelectionFormulaBitwise() {
+        Random random=new Random(7003);
+        for(int n=0;n<240;n++) {
+            long tick=random.nextInt(500);QualityTier tier=QualityTier.values()[n%3];
+            var q=DemoFixture.ring(1,tier,0,0.5,tick,0,1,2);
+            int cap=random.nextInt(73),placement=random.nextInt(220),viewer=random.nextInt(73);
+            var policy=new DeliveryPolicy(1,3,3,1152,0,placement,0,placement,viewer,cap,cap,cap);
+            Set<StyleKey> styles=n%4==0?Set.of(DemoFixture.DUST):DemoFixture.CATALOGUE;
+            var plan=DeliveryPlanner.plan(tick,List.of(q),styles,policy);var d=plan.deliveries().getFirst();
+            var sink=new DemoFixture.Sink();
+            var report=new DefaultPlanEmitter().emit(plan,Map.of(1L,DemoFixture.context(1,0,0,0.5)),
+                new SessionStyleHealth(styles),(c,v)->Optional.empty(),DemoFixture.ANY_POINT,sink,new EmissionLimits(4096,1024));
+            List<DemoFixture.Send> expected=new ArrayList<>();
+            for(int r=0;r<d.recipientCount();r++) {
+                int left=d.recipientPoints(r);
+                for(int p=0;p<d.orderedBatchCount()&&left>0;p++) {
+                    var batch=d.frame().batches().get(d.orderedBatch(p));int kept=d.kept(p),size=batch.size();
+                    int width=(size+kept-1)/kept,offset=Math.floorMod(tick,width);
+                    for(int j=0;j<kept&&left>0;j++,left--) {
+                        int index=offset+(int)((long)j*size/kept);
+                        expected.add(new DemoFixture.Send(d.recipient(r),0,batch.style(),batch.x(index),batch.y(index),batch.z(index)));
+                    }
+                }
+            }
+            assertEquals(expected,sink.sends,"scenario "+n);assertEquals(plan.placements(),report.succeededCalls());
+            for(int i=0;i<expected.size();i++) {
+                assertEquals(Double.doubleToRawLongBits(expected.get(i).x()),Double.doubleToRawLongBits(sink.sends.get(i).x()));
+                assertEquals(Double.doubleToRawLongBits(expected.get(i).y()),Double.doubleToRawLongBits(sink.sends.get(i).y()));
+                assertEquals(Double.doubleToRawLongBits(expected.get(i).z()),Double.doubleToRawLongBits(sink.sends.get(i).z()));
+            }
+        }
+    }
+    @Test void skippedPointsAreNotPromotedBeyondRecipientPrefix() {
+        var plan=DeliveryPlanner.plan(1,List.of(DemoFixture.ring(1,QualityTier.HEAVY,0,0.5,1,0)),DemoFixture.CATALOGUE,
+            new DeliveryPolicy(1,1,1,1152,0,5,0,5,5,72,72,72));
+        var d=plan.deliveries().getFirst();var b=d.frame().batches().get(d.orderedBatch(0));
+        double first=b.x(d.selectedIndex(0,0));var sink=new DemoFixture.Sink();
+        var report=new DefaultPlanEmitter().emit(plan,Map.of(1L,DemoFixture.context(1,0,0,0.5)),new SessionStyleHealth(DemoFixture.CATALOGUE),
+            (c,v)->Optional.empty(),(w,x,y,z)->x==first?Optional.of(SkipReason.POINT_OUTSIDE_WORLD):Optional.empty(),sink,new EmissionLimits(4096,1024));
+        assertEquals(4,sink.sends.size());assertEquals(1L,report.skippedPoints().get(SkipReason.POINT_OUTSIDE_WORLD));
+        assertEquals(b.x(d.selectedIndex(0,1)),sink.sends.getFirst().x());
+    }
+    @Test void limitsCountFailuresAndApplyAcrossRecipients() {
+        var plan=DeliveryPlanner.plan(0,List.of(DemoFixture.ring(1,QualityTier.HEAVY,0,0.5,0,0,1)),DemoFixture.CATALOGUE,DemoFixture.roomy());
+        var sink=new DemoFixture.Sink();sink.alwaysFail=DemoFixture.END_ROD;
+        var report=new DefaultPlanEmitter().emit(plan,Map.of(1L,DemoFixture.context(1,0,0,0.5)),new SessionStyleHealth(DemoFixture.CATALOGUE),
+            (c,v)->Optional.empty(),DemoFixture.ANY_POINT,sink,new EmissionLimits(7,5));
+        assertEquals(7,report.attemptedCalls());assertEquals(3,report.failedCalls());assertEquals(4,report.succeededCalls());
+        assertTrue(sink.count(0)<=2);assertTrue(sink.count(1)<=5);assertEquals(plan.placements(),report.attemptedCalls()+
+            report.skippedPoints().values().stream().mapToLong(Long::longValue).sum());
+    }
+    @Test void allGateReasonsSkipOnlyTheirRecipientAndPreserveAccounting() {
+        for(SkipReason reason:List.of(SkipReason.VIEWER_OFFLINE,SkipReason.VIEWER_WORLD_CHANGED,SkipReason.VIEWER_PERMISSION_REVOKED,
+            SkipReason.VIEWER_POSITION_INVALID,SkipReason.VIEWER_OUT_OF_RANGE)) {
+            var plan=DeliveryPlanner.plan(0,List.of(DemoFixture.ring(1,QualityTier.SIMPLE,0,0.5,0,0,1)),DemoFixture.CATALOGUE,DemoFixture.roomy());
+            var sink=new DemoFixture.Sink();var report=new DefaultPlanEmitter().emit(plan,Map.of(1L,DemoFixture.context(1,0,0,0.5)),
+                new SessionStyleHealth(DemoFixture.CATALOGUE),(c,v)->v==0?Optional.of(reason):Optional.empty(),DemoFixture.ANY_POINT,sink,new EmissionLimits(4096,1024));
+            assertEquals(0,sink.count(0));assertEquals(24,sink.count(1));assertEquals(24,report.placementsInSkippedRecipients());
+            assertEquals(1L,report.skippedRecipients().get(reason));assertEquals(plan.placements(),report.attemptedCalls()+report.placementsInSkippedRecipients());
+        }
+    }
+    @Test void demoRecipePreservesCountsRadiiLoopAndStaticAnchor() {
+        var recipe=DemoRecipe.create(600);
+        for(var tier:QualityTier.values()) {
+            int total=switch(tier){case SIMPLE->24;case BALANCED->48;case HEAVY->72;};
+            var q=DeliveryRequest.of(1,recipe,tier,0,workshop.vfx.math.core.Pose.ofTranslation(new workshop.vfx.math.core.Vec3(-3.5,64.1,10.5)),
+                workshop.vfx.math.time.Playback.start(workshop.vfx.math.time.TimePoint.gameTick(100)),workshop.vfx.math.time.TimePoint.gameTick(143),43,new long[]{0});
+            var d=DeliveryPlanner.plan(143,List.of(q),DemoFixture.CATALOGUE,DemoFixture.roomy()).deliveries().getFirst();
+            assertEquals(total,d.sourcePoints());assertEquals(total,d.keptPoints());
+            for(FrameBatch batch:d.frame().batches())for(int i=0;i<batch.size();i++) {
+                assertEquals(64.1,batch.y(i));double x=batch.x(i)+3.5,z=batch.z(i)-10.5;
+                assertEquals(batch.style().equals(DemoFixture.END_ROD)?2.0:2.25,Math.hypot(x,z),1e-12);
+            }
+        }
+    }
+    @Test void pointValidationRejectsEveryNonfiniteAxisAndHonorsWorldEdges() {
+        java.util.concurrent.atomic.AtomicInteger borderCalls=new java.util.concurrent.atomic.AtomicInteger();
+        for(int axis=0;axis<3;axis++) for(double invalid:new double[]{Double.NaN,Double.NEGATIVE_INFINITY,Double.POSITIVE_INFINITY}) {
+            double[] xyz={0,64,0};xyz[axis]=invalid;
+            assertEquals(Optional.of(SkipReason.POINT_NOT_FINITE),WorldPointRules.check(xyz[0],xyz[1],xyz[2],-64,320,()->{borderCalls.incrementAndGet();return true;}));
+        }
+        assertEquals(0,borderCalls.get());
+        assertTrue(WorldPointRules.check(0,-64,0,-64,320,()->true).isEmpty());
+        assertTrue(WorldPointRules.check(0,Math.nextDown(320.0),0,-64,320,()->true).isEmpty());
+        assertEquals(Optional.of(SkipReason.POINT_OUTSIDE_WORLD),WorldPointRules.check(0,320,0,-64,320,()->true));
+        assertEquals(Optional.of(SkipReason.POINT_OUTSIDE_WORLD),WorldPointRules.check(0,Math.nextDown(-64.0),0,-64,320,()->true));
+        assertEquals(Optional.of(SkipReason.POINT_OUTSIDE_WORLD),WorldPointRules.check(0,64,0,-64,320,()->false));
+    }
+}
diff --git a/paper-adapter/src/test/java/workshop/vfx/paper/core/RecipientRuleRobustnessTest.java b/paper-adapter/src/test/java/workshop/vfx/paper/core/RecipientRuleRobustnessTest.java
new file mode 100644
index 0000000..76e7c02
--- /dev/null
+++ b/paper-adapter/src/test/java/workshop/vfx/paper/core/RecipientRuleRobustnessTest.java
@@ -0,0 +1,94 @@
+package workshop.vfx.paper.core;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+
+import java.util.Optional;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+
+/**
+ * R3 F1: the owner-aware rule fails closed on invalid coordinates (contract section 7, step 1). Pure unit tests of the
+ * scratch reference OwnerAwareRecipientRule; no planner involved.
+ */
+class RecipientRuleRobustnessTest {
+    private static final long OWNER = 0, OTHER = 1;
+    private static final double R = 32.0;
+    private static final RecipientRule RULE = new OwnerAwareRecipientRule(R);
+    private static final double[] BAD = {Double.NaN, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY};
+
+    private static RequestContext ctx(double ax, double ay, double az) {
+        return new RequestContext(10, OWNER, 0, ax, ay, az);
+    }
+
+    private static ViewerFacts at(double x, double y, double z) {
+        return new ViewerFacts(true, true, 0, x, y, z, true, true);
+    }
+
+    private static final RequestContext GOOD = ctx(0.5, 64.0, 0.5);
+
+    @Test
+    @DisplayName("Viewer x, y or z NaN, +infinity or -infinity: denied as VIEWER_POSITION_INVALID (owner and non-owner)")
+    void invalidViewerPosition() {
+        for (double bad : BAD) {
+            for (long viewer : new long[] {OWNER, OTHER}) {
+                assertEquals(Optional.of(SkipReason.VIEWER_POSITION_INVALID), RULE.decide(GOOD, viewer, at(bad, 64, 0.5)), "x=" + bad);
+                assertEquals(Optional.of(SkipReason.VIEWER_POSITION_INVALID), RULE.decide(GOOD, viewer, at(0.5, bad, 0.5)), "y=" + bad);
+                assertEquals(Optional.of(SkipReason.VIEWER_POSITION_INVALID), RULE.decide(GOOD, viewer, at(0.5, 64, bad)), "z=" + bad);
+            }
+        }
+    }
+
+    @Test
+    @DisplayName("Request anchor x, y or z NaN, +infinity or -infinity: denied as INVALID_REQUEST_CONTEXT")
+    void invalidAnchor() {
+        ViewerFacts near = at(0.5, 64, 0.5);
+        for (double bad : BAD) {
+            assertEquals(Optional.of(SkipReason.INVALID_REQUEST_CONTEXT), RULE.decide(ctx(bad, 64, 0.5), OWNER, near), "ax=" + bad);
+            assertEquals(Optional.of(SkipReason.INVALID_REQUEST_CONTEXT), RULE.decide(ctx(0.5, bad, 0.5), OTHER, near), "ay=" + bad);
+            assertEquals(Optional.of(SkipReason.INVALID_REQUEST_CONTEXT), RULE.decide(ctx(0.5, 64, bad), OWNER, near), "az=" + bad);
+        }
+        // both invalid: the context is reported (anchor checked before viewer position)
+        assertEquals(Optional.of(SkipReason.INVALID_REQUEST_CONTEXT), RULE.decide(ctx(Double.NaN, 64, 0.5), OWNER, at(Double.NaN, 64, 0.5)));
+    }
+
+    @Test
+    @DisplayName("Normal controls: in range allowed, exactly at the radius allowed, just beyond and huge finite coordinates denied")
+    void normalControls() {
+        assertEquals(Optional.empty(), RULE.decide(GOOD, OWNER, at(0.5, 64, 0.5)));
+        assertEquals(Optional.empty(), RULE.decide(GOOD, OTHER, at(0.5 + 31.9, 64, 0.5)));
+        assertEquals(Optional.empty(), RULE.decide(GOOD, OTHER, at(0.5 + 32.0, 64, 0.5)), "d = radius is in range");
+        assertEquals(Optional.of(SkipReason.VIEWER_OUT_OF_RANGE), RULE.decide(GOOD, OTHER, at(0.5 + 32.001, 64, 0.5)));
+        assertEquals(Optional.of(SkipReason.VIEWER_OUT_OF_RANGE), RULE.decide(GOOD, OTHER, at(0.5, 64 - 40, 0.5)));
+        // finite but huge: the squared distance overflows to +infinity, which is still out of range
+        assertEquals(Optional.of(SkipReason.VIEWER_OUT_OF_RANGE), RULE.decide(GOOD, OWNER, at(1e200, 64, 0.5)));
+        assertEquals(Optional.of(SkipReason.VIEWER_OUT_OF_RANGE), RULE.decide(GOOD, OWNER, at(-Double.MAX_VALUE, 64, 0.5)));
+    }
+
+    @Test
+    @DisplayName("Authorization order for normal inputs is unchanged: offline, world, permission, then range checks")
+    void order() {
+        ViewerFacts offlineNaN = new ViewerFacts(false, true, 0, Double.NaN, 64, 0.5, true, true);
+        assertEquals(Optional.of(SkipReason.VIEWER_OFFLINE), RULE.decide(GOOD, OWNER, offlineNaN));
+        assertEquals(Optional.of(SkipReason.VIEWER_OFFLINE), RULE.decide(GOOD, OWNER, null), "missing facts deny");
+        ViewerFacts invalidEntity = new ViewerFacts(true, false, 0, 0.5, 64, 0.5, true, true);
+        assertEquals(Optional.of(SkipReason.VIEWER_OFFLINE), RULE.decide(GOOD, OWNER, invalidEntity));
+        ViewerFacts otherWorldNaN = new ViewerFacts(true, true, 1, Double.NaN, 64, 0.5, true, true);
+        assertEquals(Optional.of(SkipReason.VIEWER_WORLD_CHANGED), RULE.decide(GOOD, OWNER, otherWorldNaN));
+        ViewerFacts noViewNaN = new ViewerFacts(true, true, 0, Double.NaN, 64, 0.5, true, false);
+        assertEquals(Optional.of(SkipReason.VIEWER_PERMISSION_REVOKED), RULE.decide(GOOD, OTHER, noViewNaN));
+        ViewerFacts noUseFar = new ViewerFacts(true, true, 0, 500, 64, 0.5, false, true);
+        assertEquals(Optional.of(SkipReason.VIEWER_PERMISSION_REVOKED), RULE.decide(GOOD, OWNER, noUseFar), "permission before range");
+    }
+
+    @Test
+    @DisplayName("View radius: NaN, infinite or negative is rejected at construction; 0 is valid (exact anchor only)")
+    void radiusPolicy() {
+        for (double bad : new double[] {Double.NaN, Double.POSITIVE_INFINITY, Double.NEGATIVE_INFINITY, -1e-9, -32}) {
+            assertThrows(IllegalArgumentException.class, () -> new OwnerAwareRecipientRule(bad), "radius " + bad);
+        }
+        RecipientRule zero = new OwnerAwareRecipientRule(0);
+        assertEquals(Optional.empty(), zero.decide(GOOD, OWNER, at(0.5, 64, 0.5)));
+        assertEquals(Optional.of(SkipReason.VIEWER_OUT_OF_RANGE), zero.decide(GOOD, OWNER, at(0.5, 64, 0.5001)));
+    }
+}
diff --git a/paper-adapter/src/test/java/workshop/vfx/paper/core/RequestContextConsistencyTest.java b/paper-adapter/src/test/java/workshop/vfx/paper/core/RequestContextConsistencyTest.java
new file mode 100644
index 0000000..47cd360
--- /dev/null
+++ b/paper-adapter/src/test/java/workshop/vfx/paper/core/RequestContextConsistencyTest.java
@@ -0,0 +1,139 @@
+package workshop.vfx.paper.core;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertNull;
+import static workshop.vfx.paper.core.DemoFixture.ANY_POINT;
+import static workshop.vfx.paper.core.DemoFixture.CATALOGUE;
+import static workshop.vfx.paper.core.DemoFixture.context;
+import static workshop.vfx.paper.core.DemoFixture.ring;
+import static workshop.vfx.paper.core.DemoFixture.roomy;
+
+import java.util.HashMap;
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.DisplayName;
+import org.junit.jupiter.api.Test;
+import workshop.vfx.delivery.DeliveryPlan;
+import workshop.vfx.delivery.DeliveryPlanner;
+import workshop.vfx.delivery.QualityTier;
+
+/**
+ * R3: request-context consistency and fail-closed coordinates at the emitter (contract section 7). Plans come from the
+ * real accepted DeliveryPlanner; the emitter, rule and style health are the scratch reference.
+ */
+class RequestContextConsistencyTest {
+    private static final long A = 0, B = 1;
+    private static final long RING_A = 10, RING_B = 11;
+    private static final EmissionLimits LIMITS = new EmissionLimits(4096, 1024);
+
+    /** Ring A (owner A, SIMPLE: 24 points) and ring B (owner B, HEAVY: 72 points); both visible to A and B. */
+    private static DeliveryPlan plan() {
+        return DeliveryPlanner.plan(0, List.of(ring(RING_A, QualityTier.SIMPLE, 0, 0.5, 0, A, B),
+                ring(RING_B, QualityTier.HEAVY, 0, 0.5, 0, A, B)), CATALOGUE, roomy());
+    }
+
+    private static Map<Long, RequestContext> valid() {
+        Map<Long, RequestContext> m = new HashMap<>();
+        m.put(RING_A, context(RING_A, A, 0, 0.5));
+        m.put(RING_B, context(RING_B, B, 0, 0.5));
+        return m;
+    }
+
+    private static DemoFixture.Viewers viewers() {
+        return new DemoFixture.Viewers().put(A, true, false).put(B, true, false);
+    }
+
+    private static EmissionReport emit(DeliveryPlan p, Map<Long, RequestContext> ctx, DemoFixture.Viewers v, DemoFixture.Sink sink) {
+        return new DefaultPlanEmitter().emit(p, ctx, new SessionStyleHealth(CATALOGUE), v.gate(), ANY_POINT, sink, LIMITS);
+    }
+
+    /** Every planned placement is accounted for exactly once (contract section 7.2). */
+    private static void assertAccounting(DeliveryPlan p, EmissionReport r) {
+        long skippedPoints = r.skippedPoints().values().stream().mapToLong(Long::longValue).sum();
+        assertEquals(p.placements(), r.plannedPlacements());
+        assertEquals(r.plannedPlacements(),
+                r.attemptedCalls() + skippedPoints + r.placementsInSkippedRecipients() + r.placementsInSkippedDeliveries());
+        assertEquals(r.attemptedCalls(), r.succeededCalls() + r.failedCalls());
+    }
+
+    @Test
+    @DisplayName("Control: valid contexts; each owner sees its own ring; non-owners without view are refused; accounting balances")
+    void validContextsUnaffected() {
+        DemoFixture.Sink sink = new DemoFixture.Sink();
+        DeliveryPlan p = plan();
+        EmissionReport r = emit(p, valid(), viewers(), sink);
+        assertEquals(24, sink.count(A));
+        assertEquals(72, sink.count(B));
+        assertEquals(2L, r.skippedRecipients().get(SkipReason.VIEWER_PERMISSION_REVOKED));
+        assertEquals(72 + 24, r.placementsInSkippedRecipients());
+        assertEquals(0, r.placementsInSkippedDeliveries());
+        assertAccounting(p, r);
+    }
+
+    @Test
+    @DisplayName("Swapped contexts (key ring A holds ring B's context with owner B, and vice versa): both deliveries rejected, nothing sent")
+    void swappedContexts() {
+        Map<Long, RequestContext> swapped = Map.of(RING_A, context(RING_B, B, 0, 0.5), RING_B, context(RING_A, A, 0, 0.5));
+        DemoFixture.Sink sink = new DemoFixture.Sink();
+        DeliveryPlan p = plan();
+        EmissionReport r = emit(p, swapped, viewers(), sink);
+        assertEquals(0, sink.sends.size(), "a swapped owner would otherwise authorize B for ring A");
+        assertEquals(2L, r.skippedDeliveries().get(SkipReason.MISMATCHED_REQUEST_CONTEXT));
+        assertEquals(0, r.attemptedCalls());
+        assertEquals(p.placements(), r.placementsInSkippedDeliveries());
+        assertNull(r.skippedRecipients().get(SkipReason.VIEWER_PERMISSION_REVOKED), "rejected before any recipient check");
+        assertAccounting(p, r);
+    }
+
+    @Test
+    @DisplayName("One mismatched context (ring B's slot names ring A, owner A): only ring B is rejected; ring A is unaffected")
+    void oneMismatch() {
+        Map<Long, RequestContext> ctx = valid();
+        ctx.put(RING_B, context(RING_A, A, 0, 0.5));
+        DemoFixture.Sink sink = new DemoFixture.Sink();
+        DeliveryPlan p = plan();
+        EmissionReport r = emit(p, ctx, viewers(), sink);
+        assertEquals(24, sink.count(A), "ring A to its owner");
+        assertEquals(0, sink.count(B), "B receives nothing: its ring was rejected, and it may not view ring A");
+        assertEquals(1L, r.skippedDeliveries().get(SkipReason.MISMATCHED_REQUEST_CONTEXT));
+        assertEquals(72 * 2, r.placementsInSkippedDeliveries());
+        assertAccounting(p, r);
+    }
+
+    @Test
+    @DisplayName("Invalid contexts (NaN or infinite anchor, negative owner or world id): the delivery is rejected whole")
+    void invalidContexts() {
+        RequestContext[] bad = {
+            new RequestContext(RING_B, B, 0, Double.NaN, 64.1, 0.5),
+            new RequestContext(RING_B, B, 0, 0.5, Double.POSITIVE_INFINITY, 0.5),
+            new RequestContext(RING_B, B, 0, 0.5, 64.1, Double.NEGATIVE_INFINITY),
+            new RequestContext(RING_B, -1, 0, 0.5, 64.1, 0.5),
+            new RequestContext(RING_B, B, -1, 0.5, 64.1, 0.5),
+        };
+        for (RequestContext c : bad) {
+            Map<Long, RequestContext> ctx = valid();
+            ctx.put(RING_B, c);
+            DemoFixture.Sink sink = new DemoFixture.Sink();
+            DeliveryPlan p = plan();
+            EmissionReport r = emit(p, ctx, viewers(), sink);
+            assertEquals(24, sink.count(A), c.toString());
+            assertEquals(0, sink.count(B), c.toString());
+            assertEquals(1L, r.skippedDeliveries().get(SkipReason.INVALID_REQUEST_CONTEXT), c.toString());
+            assertAccounting(p, r);
+        }
+    }
+
+    @Test
+    @DisplayName("A viewer with a NaN position is refused (VIEWER_POSITION_INVALID); the other viewers are unaffected")
+    void nanViewerAtEmitter() {
+        DemoFixture.Viewers v = viewers();
+        v.facts.put(B, new ViewerFacts(true, true, 0, Double.NaN, 64.0, 0.5, true, true));
+        DemoFixture.Sink sink = new DemoFixture.Sink();
+        DeliveryPlan p = plan();
+        EmissionReport r = emit(p, valid(), v, sink);
+        assertEquals(0, sink.count(B));
+        assertEquals(24, sink.count(A));
+        assertEquals(2L, r.skippedRecipients().get(SkipReason.VIEWER_POSITION_INVALID), "B in ring A and in ring B");
+        assertAccounting(p, r);
+    }
+}
