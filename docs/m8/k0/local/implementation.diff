+              for deferred in ['AuraEffect','TrailEffect','ActivationEffect','M8Recipes','RingBufferTrailHistory']:
+                  assert not any(n.endswith('/'+deferred+'.class') for n in names),deferred
+              (evidence/'plugin-contents.txt').write_text('\n'.join(names)+'\n')
+          print('PASS: exact pinned API methods; no K1–K4 visual implementations; zero production compiler warnings')
+          PY
+      - uses: actions/upload-artifact@v6
+        if: always()
+        with:
