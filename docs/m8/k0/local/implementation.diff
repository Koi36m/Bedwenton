index 0000000..4442d1e
--- /dev/null
+++ b/paper-adapter/src/main/java/workshop/vfx/paper/m8/EffectKind.java
@@ -0,0 +1,13 @@
+package workshop.vfx.paper.m8;
+
+/** K0 foundation. Kinds of opt-in demo effects sharing the single M7 tick and M6 plan. */
+public enum EffectKind {
+    /** The accepted M7 static ring (unchanged; still owned by RingDriver). */
+    RING,
+    /** Showcase A: orbit formation that follows its owner. */
+    AURA,
+    /** Showcase B: bounded movement trail behind its owner. */
+    TRAIL,
+    /** Showcase C: short, static-anchored, multi-phase animation that ends by itself. */
+    ACTIVATION
+}
diff --git a/paper-adapter/src/main/java/workshop/vfx/paper/m8/EffectScheduler.java b/paper-adapter/src/main/java/workshop/vfx/paper/m8/EffectScheduler.java
new file mode 100644
index 0000000..2cbd664
--- /dev/null
+++ b/paper-adapter/src/main/java/workshop/vfx/paper/m8/EffectScheduler.java
@@ -0,0 +1,16 @@
+package workshop.vfx.paper.m8;
+
+/**
+ * K0 foundation. What the single shared driver offers the M8 registry (architecture section 4):
+ * one capacity rule for rings and M8 effects together, and the one shared task. Main thread only.
+ */
+public interface EffectScheduler {
+    /** True when one more effect fits: {@code replacing || rings + m8Effects < maxActiveEffects} (F1). */
+    boolean hasCapacityFor(boolean replacing);
+
+    /** Starts the one shared repeating task if it is not running (idempotent). */
+    void ensureRunning();
+
+    /** Cancels the shared task when no ring and no M8 effect remains. */
+    void effectsChanged();
+}
diff --git a/paper-adapter/src/main/java/workshop/vfx/paper/m8/K0CommandRouting.java b/paper-adapter/src/main/java/workshop/vfx/paper/m8/K0CommandRouting.java
