+            build/test-results/test/
+            build/reports/tests/test/
+            paper-adapter/build/test-results/test/
+            paper-adapter/build/reports/tests/test/
+            paper-adapter/build/libs/*.jar
+      - uses: actions/upload-artifact@v6
