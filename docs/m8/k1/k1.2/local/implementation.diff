diff --git a/paper-adapter/tools/m8-k1-2/summarize.py b/paper-adapter/tools/m8-k1-2/summarize.py
new file mode 100644
index 0000000..fe52ba4
--- /dev/null
+++ b/paper-adapter/tools/m8-k1-2/summarize.py
@@ -0,0 +1,18 @@
+import sys,json,xml.etree.ElementTree as ET
+from pathlib import Path
+r=Path(sys.argv[1]);m7=set(json.loads((r/'docs/m8/k0/M7-REGRESSION-CLASSES.json').read_text()))
+counts={k:0 for k in ['tests','failures','errors','skipped']};groups={'M1-M6':0,'M7':0,'K0':0,'K1':0,'K1.1':0,'K1.2':0};files=[];seen=set()
+for folder in [r/'build/test-results/test',r/'paper-adapter/build/test-results/test']:
+ xml=sorted(folder.glob('TEST-*.xml'));assert xml,folder;files+=xml
+ for p in xml:
+  suite=ET.parse(p).getroot();name=suite.attrib['name']
+  for c in suite.findall('testcase'):seen.add(c.attrib['classname']+':'+c.attrib['name'])
+  for k in counts:counts[k]+=int(suite.attrib.get(k,0))
+  group='M1-M6' if folder==r/'build/test-results/test' else 'M7' if name in m7 else 'K0' if '.K0' in name else 'K1.1' if '.K11' in name else 'K1.2' if '.K12' in name else 'K1'
+  if group=='K1':assert '.K1' in name,name
+  groups[group]+=int(suite.attrib['tests'])
+assert groups=={'M1-M6':415,'M7':61,'K0':50,'K1':57,'K1.1':6,'K1.2':14},groups
+assert counts==dict(tests=603,failures=0,errors=0,skipped=0),counts
+baseline=json.loads((r/'docs/m8/k1/k1.2/BASELINE-TEST-IDENTIFIERS.json').read_text())
+assert set(baseline['executed_test_cases'])<=seen,sorted(set(baseline['executed_test_cases'])-seen)
+print(json.dumps(dict(counts=counts,groups=groups,xml_reports=len(files)),indent=2))
diff --git a/paper-adapter/tools/m8-k1-2/verify.sh b/paper-adapter/tools/m8-k1-2/verify.sh
new file mode 100755
index 0000000..4b943f5
--- /dev/null
+++ b/paper-adapter/tools/m8-k1-2/verify.sh
@@ -0,0 +1,14 @@
+#!/usr/bin/env bash
+set -euo pipefail
+root="$(cd "$(dirname "$0")/../../.." && pwd)"
+evidence="${1:-$(mktemp -d "${TMPDIR:-/tmp}/bedwenton-m8-k1-2.XXXXXX")}";mkdir -p "$evidence"
+cd "$root"
+./gradlew --no-daemon -Porg.gradle.java.installations.auto-download=false clean test 2>&1 | tee "$evidence/engine-clean-test.log"
+./gradlew --no-daemon -Porg.gradle.java.installations.auto-download=false check 2>&1 | tee "$evidence/engine-check.log"
+./gradlew --no-daemon -Porg.gradle.java.installations.auto-download=false -p paper-adapter clean test 2>&1 | tee "$evidence/adapter-clean-test.log"
+./gradlew --no-daemon -Porg.gradle.java.installations.auto-download=false -p paper-adapter check 2>&1 | tee "$evidence/adapter-check.log"
+python3 paper-adapter/tools/m8-k1-2/summarize.py "$root" | tee "$evidence/test-summary.json"
+./gradlew --no-daemon -Porg.gradle.java.installations.auto-download=false dependencies --configuration runtimeClasspath 2>&1 | tee "$evidence/engine-runtime.log"
+grep -q 'No dependencies' "$evidence/engine-runtime.log"
+python3 verification/m6/regenerate_all.py "$evidence/reference-regeneration" 2>&1 | tee "$evidence/reference-regeneration.log"
+cp paper-adapter/build/reports/k1/synthetic-measurements.json "$evidence/"
